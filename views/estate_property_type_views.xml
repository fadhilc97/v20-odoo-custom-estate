<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="estate_property_type_form_view" model="ir.ui.view">
    <field name="name">estate.property.type.form.view</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
      <form string="Property Type Form">
        <sheet>
          <div class="oe_title">
            <h1 class="mb32">
              <field name="name" class="mb16"/>
            </h1>
          </div>
          <notebook>
            <page string="Properties">
              <field name="property_ids" readonly="1">
                <list>
                  <field name="name" string="Title"/>
                  <field name="expected_price"/>
                  <field name="state" string="Status"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="estate_property_type_list_view" model="ir.ui.view">
    <field name="name">estate.property.type.list.view</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle" />
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="estate_property_type_action" model="ir.actions.act_window">
    <field name="name">Estate Property Type</field>
    <field name="res_model">estate.property.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Define a new estate property type
      </p>
    </field>
  </record>
</odoo>